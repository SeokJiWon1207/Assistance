        {
          "name": "platform",
          "label": "플랫폼",
          "type": "select",
          "value": "전체",
          "options": [
            "전체",
            "HTS",
            "MTS"
          ]
        },
        {
          "name": "status",
          "label": "상태",
          "type": "select",
          "value": "전체",
          "options": [
            "전체",
            "미종료",
            "종료"
          ]
        }
      ]
    },
