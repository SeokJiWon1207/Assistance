COMPANY_MODEL_46_API_KEY=replace_with_company_model_api_key
COMPANY_MODEL_46_ENDPOINT=http://replace_with_model_host/v1/chat/completions
COMPANY_MODEL_46_EXPIRES_AT=2026-12-31

# Firebase Authentication (초기 설정 전에는 false)
FIREBASE_AUTH_ENABLED=false
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
# 아래 둘 중 하나만 사용합니다. JSON 원문은 배포 시 비밀 환경변수로 주입하세요.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase Console에 먼저 만든 첫 관리자 이메일. 쉼표로 여러 명 지정할 수 있습니다.
FIREBASE_BOOTSTRAP_ADMIN_EMAILS=
AUTH_SESSION_HOURS=8
# 로컬 HTTP 개발에서만 false로 덮어씁니다. 운영 HTTPS에서는 반드시 true입니다.
AUTH_COOKIE_SECURE=true

# Production transport guard
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8787
# 원격 HTTP 모델의 정확한 origin만 임시로 허용합니다. wildcard는 사용할 수 없습니다.
MODEL_ENDPOINT_INSECURE_ALLOWLIST=
MODEL_ENDPOINT_INSECURE_ALLOWLIST_EXPIRES_AT=
MODEL_ENDPOINT_INSECURE_ALLOWLIST_WARNING_DAYS=30

# Later integrations
MANTIS_API_TOKEN=replace_with_mantis_api_token
MANTIS_API_URL=http://replace_with_mantis_host/mantis/api/rest/issues
MANTIS_LIVE_REFILL_MAX_ATTEMPTS=12
# 범위 수집의 병렬 요청 수(1~6), 원본 캐시 수명(0~60초, 0이면 비활성화)
MANTIS_LIVE_MAX_WORKERS=6
MANTIS_LIVE_CACHE_TTL_SECONDS=30
NOTION_API_TOKEN=
NOTION_INCLUDE_CHILD_DATABASES=false
NOTION_DATABASE_IDS=
NOTION_MIN_REQUEST_INTERVAL_SECONDS=0.36
NOTION_TITLE_INDEX_TTL_SECONDS=86400
NOTION_READ_SCOPE_TTL_SECONDS=2592000
NOTION_API_VERSION=2022-06-28
NOTION_FETCH_PAGE_BLOCKS=true
NOTION_TOOL_TIMEOUT_SECONDS=8
NOTION_TOOL_MAX_RETRIES=0

# Optional: model automatic fallback / follow-up rewrite tuning
MODEL_HISTORY_MAX_MESSAGES=20
MODEL_TIMEOUT_SECONDS=180
FOLLOWUP_REWRITE_TIMEOUT_SECONDS=20
CHAT_MAX_CONCURRENT_PER_USER=2
CHAT_MAX_CONCURRENT_TOTAL=8
CHAT_RATE_LIMIT_PER_MINUTE=20

# Server-side conversation and audit retention limits
CONVERSATION_MAX_PER_USER=200
CONVERSATION_MAX_BYTES=1000000
CONVERSATION_MAX_TOTAL_BYTES_PER_USER=50000000
AUDIT_RETENTION_DAYS=90
NOTION_CACHE_TTL_SECONDS=600
SNAPSHOT_MIN_DOCUMENTS=1
SNAPSHOT_BACKUP_KEEP=3
# 구조화 보조 인덱스 롤아웃: off | shadow | primary
MANTIS_INDEX_MODE=shadow
# MANTIS_INDEX_DB_PATH=/absolute/path/to/mantis_index.sqlite3

# Optional: scheduled accuracy check Slack notification (run_accuracy_check_and_notify.py)
SLACK_WEBHOOK_URL=
ACCURACY_CHECK_QUESTIONS=10
OBSIDIAN_VAULT_PATH=
OBSIDIAN_ACCURACY_FOLDER=Automation Reports/Mantis Notion
# Chroma 의미 유사도 검색 (make_vector_db.py와 같은 임베딩 모델 사용)
OLLAMA_BASE_URL=http://127.0.0.1:11434
CHROMA_EMBEDDING_MODEL=bge-m3:latest
CHROMA_EMBEDDING_TIMEOUT_SECONDS=12
# Local Ollama needs no API key. The app recognizes provider=ollama in models.json.
